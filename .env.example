# Data Deals — environment variables. Copy names into Render → data-deals-backend → Environment.
# NEVER put real values in this file or in GitHub.

# Required
NODE_ENV=production
DATABASE_URL=            # Neon connection string (Neon console → Connect). Keep sslmode=require.
APP_SECRET=              # Long random string (48+ chars). Signs guest receipt/ticket links.
PUBLIC_BASE_URL=         # e.g. https://data-deals-backend.onrender.com or your own domain

# Payments (Paystack → Settings → API Keys & Webhooks)
PAYSTACK_SECRET_KEY=     # sk_test_... for testing, sk_live_... for real money
# Webhook URL to paste into Paystack: <PUBLIC_BASE_URL>/api/webhooks/paystack

# Supplier (leave empty until RemaData provides API docs + keys)
REMADATA_API_KEY=
REMADATA_API_BASE_URL=
# DataMart GH supplier (set in Render → Environment, never in code)
DATAMART_API_KEY=
# Optional: only if you switch these protections on in DataMart
DATAMART_API_SECRET=
DATAMART_REF_PREFIX=
# DATAMART_API_BASE_URL=https://api.datamartgh.shop/api/developer

# Email (optional — enables password-reset emails and order emails) https://resend.com
RESEND_API_KEY=
EMAIL_FROM=              # e.g. Data Deals <orders@yourdomain.com>

# Optional
ALLOWED_ORIGINS=         # extra site origins allowed to call the API, comma separated
DB_POOL_MAX=8
LOG_LEVEL=info
